{
  "schema": "circle-line-stockapp-drawing-contract",
  "version": 1,
  "source": "technical-patterns/patterns.json",
  "storage": {
    "technicalField": "technicalSpecifications",
    "technicalFieldType": "JSON stored as TEXT in SQLite",
    "normalProductFields": [
      "name",
      "description",
      "category"
    ],
    "technicalKeys": [
      "version",
      "type",
      "bearingSeat (rollers only)",
      "dimensions",
      "properties",
      "notes"
    ],
    "optionalProperties": [
      "material",
      "hardness",
      "finish"
    ],
    "notesOptional": true,
    "doNotAddDimensionsAsDatabaseColumns": true
  },
  "matching": {
    "default": "technicalSpecifications.type",
    "rollers": {
      "key": "bearingSeat",
      "values": [
        "none",
        "one_side",
        "both_sides"
      ],
      "selection": "type + bearingSeat"
    },
    "solid_carbide_end_mill": {
      "type": "solid_carbide_end_mill",
      "selection": "compare dimensions[cutting_diameter].value and dimensions[shank_diameter].value in mm",
      "cases": [
        {
          "id": "solid_carbide_end_mill__equal",
          "when": "shank_diameter == cutting_diameter"
        },
        {
          "id": "solid_carbide_end_mill__shank_larger",
          "when": "shank_diameter > cutting_diameter"
        },
        {
          "id": "solid_carbide_end_mill__shank_smaller",
          "when": "shank_diameter < cutting_diameter"
        }
      ],
      "additionalProductFieldNeeded": false
    }
  },
  "categories": [
    {
      "name": "Bolts & Studs",
      "types": [
        "hex_bolt",
        "t_bolt",
        "double_ended_stud"
      ]
    },
    {
      "name": "Nuts",
      "types": [
        "hex_nut",
        "lock_nut",
        "flange_nut"
      ]
    },
    {
      "name": "Bushes",
      "types": [
        "plain_bush",
        "flanged_bush"
      ]
    },
    {
      "name": "Washers",
      "types": [
        "flat_washer",
        "spring_washer",
        "hardened_washer"
      ]
    },
    {
      "name": "Rollers",
      "types": [
        "v_groove",
        "radius_groove",
        "flat_bottom_v_groove"
      ]
    },
    {
      "name": "Bearings",
      "types": [
        "deep_groove_ball_bearing"
      ]
    },
    {
      "name": "Workshop Tools",
      "types": [
        "carbide_drill",
        "solid_carbide_end_mill"
      ]
    }
  ],
